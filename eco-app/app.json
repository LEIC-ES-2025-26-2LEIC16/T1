{
  "expo": {
    "name": "MyImpact",
    "slug": "eco-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ecoapp",
    "userInterfaceStyle": "automatic", 
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.myimpact.app",
      "infoPlist": {
         "LSApplicationQueriesSchemes": ["ecoapp"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.myimpact.app",

      "intentFilters": [
    {
      "action": "VIEW",
      "autoVerify": false,
      "data": [
        {
          "scheme": "ecoapp",
          "host": "auth"
        }
      ],
      "category": ["BROWSABLE", "DEFAULT"]
    }
  ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Esta app precisa da tua localização para registar a posição do ecoponto."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MyImpact to access your camera to log recycling."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow MyImpact to access your camera to log recycling.",
          "photosPermission": "Allow MyImpact to access your photos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {  
        "projectId": "09c42625-ca9d-458c-8157-9896be3c47b8"
      }
    }
  }
}
